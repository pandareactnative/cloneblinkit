<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="15702" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="retina6_1" orientation="portrait" appearance="light"/>
    <dependencies><deployment identifier="iOS"/><plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="15704"/></dependencies>
    <scenes><scene sceneID="launch-scene"><objects>
        <viewController id="launch-controller" sceneMemberID="viewController">
            <view key="view" contentMode="scaleToFill" id="launch-view">
                <rect key="frame" x="0" y="0" width="375" height="812"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="MyntraLaunchLogo" translatesAutoresizingMaskIntoConstraints="NO" id="launch-logo"><rect key="frame" x="148.5" y="353" width="78" height="78"/></imageView>
                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Myntra" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="launch-name"><rect key="frame" x="100" y="438" width="175" height="31"/><fontDescription key="fontDescription" name="HelveticaNeue-Bold" family="Helvetica Neue" pointSize="25"/><color key="textColor" red="0.157" green="0.173" blue="0.247" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></label>
                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="E V E R Y T H I N G  Y O U  N E E D  T O  L O O K  G O O D" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="launch-tagline"><rect key="frame" x="20" y="760" width="335" height="12"/><fontDescription key="fontDescription" name="HelveticaNeue" family="Helvetica Neue" pointSize="8"/><color key="textColor" red="0.635" green="0.639" blue="0.674" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></label>
                </subviews>
                <viewLayoutGuide key="safeArea" id="launch-safe"/>
                <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                <constraints>
                    <constraint firstItem="launch-logo" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="logo-x"/>
                    <constraint firstItem="launch-logo" firstAttribute="centerY" secondItem="launch-view" secondAttribute="centerY" constant="-20" id="logo-y"/>
                    <constraint firstItem="launch-logo" firstAttribute="width" secondItem="launch-view" secondAttribute="width" multiplier="0.208" id="logo-width"/>
                    <constraint firstItem="launch-logo" firstAttribute="height" secondItem="launch-logo" secondAttribute="width" id="logo-height"/>
                    <constraint firstItem="launch-name" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="name-x"/>
                    <constraint firstItem="launch-name" firstAttribute="top" secondItem="launch-logo" secondAttribute="bottom" constant="0" id="name-y"/>
                    <constraint firstItem="launch-tagline" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="tagline-x"/>
                    <constraint firstItem="launch-safe" firstAttribute="bottom" secondItem="launch-tagline" secondAttribute="bottom" constant="8" id="tagline-y"/>
                </constraints>
            </view>
        </viewController><placeholder placeholderIdentifier="IBFirstResponder" id="first-responder" sceneMemberID="firstResponder"/>
    </objects></scene></scenes>
    <resources><image name="MyntraLaunchLogo" width="96" height="96"/></resources>
</document>
